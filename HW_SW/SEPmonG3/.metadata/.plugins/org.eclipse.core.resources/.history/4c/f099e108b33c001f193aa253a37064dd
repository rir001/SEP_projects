int batalla(struct pokemon* pkm1, struct pokemon* pkm2){


	animacion_inicio(pkm1, pkm2);


	int turno = 1;
	int dano1 = 0;

	while (1){
		if (pkm1->vida <= 0){
			pkm1->vida = 0;
			return 0;
			break;

		}

		if (pkm2->vida <= 0){
			pkm2->vida = 0;
			return 1;
			break;

		}

		if (turno){
			dano1 = atacar(pkm1, pkm2);

			if (dano1 == -1){
				int aa;
				aa = rand()%16;
				xil_printf("%c esta confundido y se ha hecho dano a si mismo\n\r", *pkm1->nombre);
				pkm1->vida -= aa;
				draw_hp_bar(pkm1->vida,pkm1->vida_max, 1);
			}
			else{
				pkm2->vida -= dano1;
				animacion_gengar();
				draw_hp_bar(pkm2->vida,pkm2->vida_max, 0);
			}


			turno  = 0;
		}
		else{
			int poder;
			poder = rand()%100;
			dano1 = ((0.2* (float) pkm1->lvl + 1.0) * (float) pkm1->atk * (float) poder)/(25.0 * pkm2->def) + 2;
			delay_ms(500);
			animacion_nidorino();

			pkm1->vida -= (int) dano1;
			draw_hp_bar(pkm1->vida,pkm1->vida_max, 1);

			display_string_in_box(nidorinoatk);
			delay_ms(500);

			clear_box();

			turno = 1;
		}

		xil_printf("dano: %d", dano1);

		resultado_ataque(dano1,turno);





	}
	return 1;
}

