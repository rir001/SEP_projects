int atacar(struct pokemon* pkm1, struct pokemon* pkm2)
{

	int poder;
	int ataque;
	int x;
	int y;
	int buffer_x;
	int buffer_y;
	int buffer_ataque = 5;

	xil_printf("Que deberia hacer %c \n\r", pkm1->nombre);
	clear_box();

	draw_attacks();

	waiting_input = 1;


	while(waiting_input){

		x = read_joyx();
		y = read_joyy();


		if ((x != buffer_x) | (y != buffer_y)) {
			if(x > 530 && y > 530){
				ataque = 2;

			}

			else if(x < 510 && y > 530){
				ataque = 0;

			}

			else if(x < 510 && y < 500){
				ataque = 1;

			}

			else if(x > 530 && y < 500){
				ataque = 3;

			}
		}

		buffer_x = x;
		buffer_y = y;

		if (ataque != buffer_ataque){
			draw_select_box(ataque);
			buffer_ataque = ataque;
		}

	}



	calculando = 1;
	XTmrCtr_Start(&TmrDano, TIMER_CNTR_0);

	if (ataque == 1) {
		clear_box();
		display_string_in_box(alarido);
		poder = Alarido();
		clear_box();
	}
	else if (ataque == 2) {
		clear_box();
		display_string_in_box(terremoto);
		poder = Terremoto();
		clear_box();
	}
	else if (ataque == 3) {
		clear_box();
		display_string_in_box(nocheoscura);
		poder = NocheOscura();
		clear_box();
	}
	else{
		clear_box();
		display_string_in_box(atkrapido);
		poder = -1;
		clear_box();
	}


	//xil_printf("El poder fue de %d\n\r", poder);

	float dano = ((0.2* (float) pkm1->lvl + 1.0) * (float) pkm1->atk * (float) poder)/(25.0 * pkm2->def) + 2;

	//xil_printf("El dano fue de %d\n\r", (int) dano);

	return (int) dano;

}


