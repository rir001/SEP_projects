startgroup
create_bd_cell -type ip -vlnv xilinx.com:ip:axi_gpio:2.0 axi_gpio_1
endgroup
set_property location {6 1772 73} [get_bd_cells axi_gpio_1]
set_property -dict [list CONFIG.C_ALL_INPUTS {1}] [get_bd_cells axi_gpio_1]
startgroup
make_bd_intf_pins_external  [get_bd_intf_pins axi_gpio_1/GPIO]
endgroup
set_property name LuzIRQ_tri_i [get_bd_intf_ports GPIO_0]
set_property name LuzIRQ [get_bd_intf_ports LuzIRQ_tri_i]
apply_bd_automation -rule xilinx.com:bd_rule:axi4 -config { Clk_master {/processing_system7_0/FCLK_CLK0 (100 MHz)} Clk_slave {Auto} Clk_xbar {/processing_system7_0/FCLK_CLK0 (100 MHz)} Master {/processing_system7_0/M_AXI_GP0} Slave {/axi_gpio_1/S_AXI} ddr_seg {Auto} intc_ip {/ps7_0_axi_periph} master_apm {0}}  [get_bd_intf_pins axi_gpio_1/S_AXI]
startgroup
set_property -dict [list CONFIG.C_INTERRUPT_PRESENT {1}] [get_bd_cells axi_gpio_1]
endgroup
delete_bd_objs [get_bd_nets LuzIRQ_1]
delete_bd_objs [get_bd_ports LuzIRQ]
connect_bd_net [get_bd_pins xlconcat_0/In2] [get_bd_pins axi_gpio_1/ip2intc_irpt]
validate_bd_design
validate_bd_design -force
report_ip_status -name ip_status 
startgroup
endgroup
startgroup
set_property -dict [list CONFIG.C_INTERRUPT_PRESENT {0}] [get_bd_cells axi_gpio_1]
delete_bd_objs [get_bd_nets axi_gpio_1_ip2intc_irpt]
endgroup
validate_bd_design
delete_bd_objs [get_bd_cells ila_1]
connect_bd_net [get_bd_pins xlconcat_0/In2] [get_bd_pins axi_gpio_1/gpio_io_i]
undo
startgroup
set_property -dict [list CONFIG.C_INTERRUPT_PRESENT {1}] [get_bd_cells axi_gpio_1]
endgroup
connect_bd_net [get_bd_pins axi_gpio_1/ip2intc_irpt] [get_bd_pins xlconcat_0/In2]
