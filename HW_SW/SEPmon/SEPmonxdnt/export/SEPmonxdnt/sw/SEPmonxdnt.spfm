<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="SEPmonxdnt"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
SEPmonxdnt
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="SEPmonxdnt">
        <sdx:configuration sdx:name="SEPmonxdnt"
                           sdx:displayName="SEPmonxdnt"
                           sdx:defaultProcessorGroup="standalone_domain"
                           sdx:runtimes="cpp">
            <sdx:description>SEPmonxdnt</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="SEPmonxdnt/boot/SEPmonxdnt.bif"
                            sdx:readme="SEPmonxdnt/boot/generic.readme"
                            sdx:qemuArguments="SEPmonxdnt/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="standalone_domain"
                            sdx:bif="SEPmonxdnt/boot/SEPmonxdnt.bif"
                            sdx:readme="SEPmonxdnt/boot/generic.readme"
                            sdx:qemuArguments="SEPmonxdnt/standalone_domain/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_domain"
                                sdx:displayName="standalone on ps7_cortexa9_0"
                                sdx:cpuType="cortex-a9"
                                sdx:cpuInstance="ps7_cortexa9_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="SEPmonxdnt/standalone_domain/bsplib/lib"
                        sdx:bspIncludePaths="SEPmonxdnt/standalone_domain/bspinclude/include"
                        sdx:bspConfig="SEPmonxdnt/standalone_domain/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
