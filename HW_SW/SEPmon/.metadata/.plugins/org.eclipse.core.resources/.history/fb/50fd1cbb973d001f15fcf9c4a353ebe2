int batalla(struct pokemon* pkm1, struct pokemon* pkm2){
	/* estado de batalla*/
	/*se hace la animacion incial de los pokemon*/

	animacion_inicio(pkm1, pkm2);
	/* y se empiza a correr el timer que hace que estos se vayan actualizando*/

	XTmrCtr_Start(&TmrScreen, TIMER_CNTR_0);
	estado = 1;

	/* se inicia con los turnos, e forma alternante*/
	int turno = 1;
	int dano1 = 0;

	while (1){

		/*se va chequeando si alguno de los pokemon quedo sin vida, en cuyo caso se termina la batalla*/


		if (pkm1->vida <= 0){
			pkm1->vida = 0;
			return 0;
			break;

		}

		if (pkm2->vida <= 0){
			pkm2->vida = 0;
			return 1;
			break;

		}

		/* si ambos siguen con vida se van alternando los turnos*/

		if (turno){
			/* se calcula el daño que hace gengar a nidorino mediante los perifericos*/

			dano1 = atacar(pkm1, pkm2);

			if (dano1 == -1){
				/*esto solo ocurre cuando se usa ataque rapido configurado en perder, lo que sirve para forzar la victoria de nidorino*/
				int aa;
				aa = pkm1->vida;
				xil_printf("%c esta confundido y se ha hecho dano a si mismo\n\r", *pkm1->nombre);
				/*por ende gengar recibe daño que hace que piera toda la vida*/
				pkm1->vida -= aa;
				draw_hp_bar(pkm1->vida,pkm1->vida_max, 1);
			}
			else{
				/* si se recibe un valor valido, se descuenta a la vida de nidorino, y se genera la animacion de ataque de gengar*/
				pkm2->vida -= dano1;
				animacion_gengar();
				/* se actualiza la barra de vida de nidorino*/
				draw_hp_bar(pkm2->vida,pkm2->vida_max, 0);
			}


			turno  = 0;
		}
		else{
			/* en el turno de nidorino, se genera un numero al azarmhasta 100 de poder*/
			int poder;
			poder = rand()%100;
			/* y se calcula el daño mediante la formula simplificada*/
			dano1 = ((0.2* (float) pkm1->lvl + 1.0) * (float) pkm1->atk * (float) poder)/(25.0 * pkm2->def) + 2;
			delay_ms(500);
			/* se hace la animacion de ataque de nidorino*/
			animacion_nidorino();

			/* y se actualiza la vida de gengar*/

			pkm1->vida -= (int) dano1;
			draw_hp_bar(pkm1->vida,pkm1->vida_max, 1);
			/* se indica en pantalla el ataque de nidorino*/
			display_string_in_box(nidorinoatk);
			delay_ms(500);

			clear_box();

			turno = 1;
		}

		/*esta funcion permite escribir si el ataque fue muy, normal, o poco efectivo segun el daño*/
		resultado_ataque(dano1,turno, pkm1);






	}
	return 1;
}

int atacar(struct pokemon* pkm1, struct pokemon* pkm2)
{	/* estado de atacar*/
	/* en este estado se selecciona un ataque, y despues mediante el uso de perifericos se calcula el daño generado*/

	int poder;
	int ataque;
	int x;
	int y;
	int buffer_x;
	int buffer_y;
	int buffer_ataque = 5;

	/* se limpia el recuadro de texto*/

	clear_box();

	/* se escriben los ataque en el recuadro de texto*/

	draw_attacks();

	/* y se empieza a esperar que el usuario confirme un ataque mediante la interrupcion del boton*/
	waiting_input = 1;


	while(waiting_input){
		/* mediante la posicion del joystick se puede escoger cual ataque se quiere hacer*/

		x = read_joyx();
		y = read_joyy();

		/* solo se cambia la seleccion si hubo movimiento en el joystick*/
		/* se deja un rango entre las areas para que se escoja de forma mas clara*/
		if ((x != buffer_x) | (y != buffer_y)) {
			if(x > 530 && y > 530){
				ataque = 2;

			}

			else if(x < 510 && y > 530){
				ataque = 0;

			}

			else if(x < 510 && y < 500){
				ataque = 1;

			}

			else if(x > 530 && y < 500){
				ataque = 3;

			}
		}

		buffer_x = x;
		buffer_y = y;

		/* en caso de que el ataque que se esta selecionando cambie, se dibuja un recuadro al rededor de este*/

		if (ataque != buffer_ataque){
			draw_select_box(ataque);
			buffer_ataque = ataque;
		}

	}

	/* cuando finalmente se apreta el boton, se eliminan todos los recuadros*/

	draw_select_box(4);


	/* la variable calculando pasa a ser 0 cuando el timer de daño genera su interrupcion, de sta manera, se setea en 0 y se da inicio
	 * al timer, el cual dura 5 segundos.
	 */
	calculando = 1;
	XTmrCtr_Start(&TmrDano, TIMER_CNTR_0);

	/* segun el ataque seleccionado, se escribe que gengar lo utilizo en pantalla
	 * Y despues se da paso a la funcion que lee el periferico y calcula el poder del ataque*/

	if (ataque == 3) {
		clear_box();
		display_string_in_box(alarido);
		poder = Alarido();
		clear_box();
	}
	else if (ataque == 2) {
		clear_box();
		display_string_in_box(terremoto);
		poder = Terremoto();
		clear_box();
	}
	else if (ataque == 0) {
		clear_box();
		display_string_in_box(nocheoscura);
		poder = NocheOscura();
		clear_box();
	}
	else{
		/* este ultimo es ataque rapido, y permite forzar la victoria de gengar o nidorino*/
		clear_box();
		display_string_in_box(atkrapido);
		poder = 1000;
		clear_box();
		return -1;
	}


	/* se calcula el daño utilizando una formula aproximada a la que se usa en los juegos, la cual utiliza los stats de cada pokemon y el poder de ataque*/

	float dano = ((0.2* (float) pkm1->lvl + 1.0) * (float) pkm1->atk * (float) poder)/(25.0 * pkm2->def) + 2;


	return (int) dano;

}

