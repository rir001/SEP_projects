/*Funcion para calcular el logaritmo natural de un numero*/
/*creada mediante chat gpt*/

double logNatural(double x) {
    if (x <= 0) {
        return -1; // Logaritmo indefinido para valores no positivos
    }

    if (x == 1) {
        return 0; // log(1) = 0
    }

    double term, sum;
    double base = (x - 1) / (x + 1);
    double baseSquared = base * base;
    int n = 1;
    sum = 0;

    do {
        term = (2.0 / n) * base;
        sum += term;
        base *= baseSquared;
        n += 2;
    } while (term > 1e-10 || term < -1e-10); // Condición de convergencia

    return sum;
}

/*Funcion para calcular el logaritmo en base 10 de un numero*/
/*creada mediante chat gpt*/

double log10Taylor(double x) {
    double logNaturalResult = logNatural(x);
    if (logNaturalResult == -1) {
        return -1; // Logaritmo indefinido para valores no positivos
    }
    return logNaturalResult / 2.302585092994046; // 2.302585092994046 es log(10) en base e
}

/********** Handlers ****************/


void TMR_Music_Handler(void *data)
{
	/*Handler para enviar continuamente una frecuencia de interes al ipcore creado por nosotros,
	 * esta se envia cada vez que el timer 0 genera una interrupción
	 */

	/*envia la frecuencia dividiendo al clk de la zybo, para que hace el buzzer genere la frecuecia deseada*/

	Xil_Out32(dir_frecuencia ,(int) 2*125000000/frecuencias[counter1]);

	/*mediante un contador se van recorriendo todas las frecuencias que generan la canción*/

	if (counter1 <= 3472){
		counter1++;

	}
	else{
		counter1 = 0;
	}

	/*finalmente se reinicia el timer*/

	XTmrCtr_Stop(data,TIMER_CNTR_0);
	XTmrCtr_Reset(data,TIMER_CNTR_0);
	XTmrCtr_Start(data,TIMER_CNTR_0);

}

