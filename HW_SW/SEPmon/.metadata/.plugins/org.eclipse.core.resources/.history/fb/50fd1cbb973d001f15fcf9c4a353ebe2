/************** Ataques ****************/

int Alarido(){
	/* ataque alarido, se utiliza el microfono para calcular el daño*/

	int grito = 0;
	int contador = 0;
	while (calculando){
		/* mintras duran los 5 segundo se suma cuanto sonido se esta haciendo.
		 * Para esto se tiene en consideración 2 cosas
		 * Que el microfono sin ruido marca 512
		 * Y que cuando hay ruido puede subir o bajar de este valor, por ende se suma la diferencia en valor absoluto
		 */
		grito += abs(read_MIC() - 512);
		contador += 1;

	}
	/* tras eso se divide por la cantidad de muestras tomadas*/
	/* y se normaliza para que el poder vaya entre 10 y 100*/

	float ruido = (float) grito / (float) contador ;
	float poder = 90.0/250.0 * ruido + 10.0;

	return (int) poder;

}

int Terremoto(){
	/* ataque terremoto, utiliza el acelerometro para calcular el daño*/

	float movimiento = 0;
	float poder;

	int x;
	int y;
	int z;

	int buffer_x = read_acx();
	int buffer_y = read_acy();
	int buffer_z = read_acz();

	float dx = 0; /// cambiar a que partan con el valor de la lectura
	float dy = 0;
	float dz = 0;

	/* para calcular el daño se  calcula la diferencia entre los valores actuales y los del instante anterior
	 * asi midiendo cuanto se mueve la tarjeta
	 */

	int contador = 0;
	while (calculando){

		x = read_acx();
		y = read_acy();
		z = read_acz();

		/* se utiliza el valor absoluto ya que nos interesa el cambio, no si es mayor o menor*/

		dx = (float) abs(x - buffer_x);
		dy = (float) abs(y - buffer_y);
		dz = (float) abs(z - buffer_z);

		printf("dx: %f, dy: %f, dz: %f \n\r", dx, dy, dz);

		buffer_x = x;
		buffer_y = y;
		buffer_z = z;

		movimiento += (dx + dy + dz); /*se suma cuando cambio en cada eje*/
		contador += 1;

	}
	/* y se divide por las muestras tomadas, normalizandose para que el poder vaya entre 10 y 100*/

	float terremoto =  movimiento / (float) contador ;
	poder = terremoto*11.0/4.0 + 10.0;

	return (int) poder;

}

int NocheOscura(){
	/* ataque noche oscura, utiliza el sensor de luz para medir el daño*/

	int luz;
	double poder;
	/* se mide la luz al momento de realizar el ataque, */
	luz = read_opt();

	/*y dado que esta tiene un rango muy amplio se usa el logaritmo de su valor, para normalizarla y que el
	 * poder vaya entre 10 y 100
	 */
	double logluz = log10Taylor((double) luz);

	poder =  152.8 - 31.0*logluz;
	//xil_printf("poder = %d \n\r", (int) poder);


	return (int) poder;

}


