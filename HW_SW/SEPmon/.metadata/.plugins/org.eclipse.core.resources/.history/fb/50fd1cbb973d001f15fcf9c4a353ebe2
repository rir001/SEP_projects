/*********** Interrupts ****************/

int IntcInitFunction(u16 DeviceId, XTmrCtr *TmrInstancePtr, XTmrCtr *TmrInstancePtr1, XTmrCtr *TmrInstancePtr2)
{
	XScuGic_Config *IntcConfig;
	int status;

	/*Se configura el controlador de interupciones*/
	IntcConfig = XScuGic_LookupConfig(DeviceId);
	status = XScuGic_CfgInitialize(&INTC, IntcConfig, IntcConfig->CpuBaseAddress);
	if(status != XST_SUCCESS) return XST_FAILURE;

	/*Se habilita el controlador de interrupciones*/
	status = InterruptSystemSetup(&INTC);
	if(status != XST_SUCCESS) return XST_FAILURE;


	/*Se configuran las prioridades de las5 interrupciones*/
	XScuGic_SetPriorityTriggerType(&INTC, INTC_LIGHT_INTERRUPT_ID, 0x18, 0x1);
	XScuGic_SetPriorityTriggerType(&INTC, INTC_BTN_INTERRUPT_ID, 0x20, 0x1);
	XScuGic_SetPriorityTriggerType(&INTC, INTC_TMR_INTERRUPT_ID, 0x22, 0x1);
	XScuGic_SetPriorityTriggerType(&INTC, INTC_TMR_INTERRUPT_ID_1, 0x24, 0x1);
	XScuGic_SetPriorityTriggerType(&INTC, INTC_TMR_INTERRUPT_ID_2, 0x26, 0x1);

	/*Se conectan las interrupciones a sus respectivos handlers*/
	status = XScuGic_Connect(&INTC,INTC_BTN_INTERRUPT_ID,(Xil_ExceptionHandler)Btn_Handler, (void *)0);
	status = XScuGic_Connect(&INTC,INTC_LIGHT_INTERRUPT_ID,(Xil_ExceptionHandler)Light_Handler, (void *)0);
	status = XScuGic_Connect(&INTC,INTC_TMR_INTERRUPT_ID,(Xil_ExceptionHandler)TMR_Music_Handler,(void *) TmrInstancePtr);
	status = XScuGic_Connect(&INTC,INTC_TMR_INTERRUPT_ID_1,(Xil_ExceptionHandler)TMR_Screen_Handler,(void *) TmrInstancePtr1);
	status = XScuGic_Connect(&INTC,INTC_TMR_INTERRUPT_ID_2,(Xil_ExceptionHandler)TMR_Dano_Handler,(void *) TmrInstancePtr2);


	/*Se habilitan las interrupaciones*/
	if(status != XST_SUCCESS) return XST_FAILURE;
	XScuGic_Enable(&INTC, INTC_BTN_INTERRUPT_ID);
	XScuGic_Enable(&INTC, INTC_LIGHT_INTERRUPT_ID);
	XScuGic_Enable(&INTC, INTC_TMR_INTERRUPT_ID);
	XScuGic_Enable(&INTC, INTC_TMR_INTERRUPT_ID_1);
	XScuGic_Enable(&INTC, INTC_TMR_INTERRUPT_ID_2);

	return XST_SUCCESS;
}

int InterruptSystemSetup(XScuGic *XScuGicInstancePtr)
{

	Xil_ExceptionRegisterHandler(XIL_EXCEPTION_ID_INT,
	(Xil_ExceptionHandler)XScuGic_InterruptHandler,
	XScuGicInstancePtr);

	Xil_ExceptionEnable();

	return XST_SUCCESS;

}

